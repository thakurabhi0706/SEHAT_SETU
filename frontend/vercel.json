{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE_URL": "@sehat-setu-api-url",
    "VITE_GEOAPIFY_API_KEY": "@sehat-setu-geoapify-key",
    "VITE_RAZORPAY_KEY_ID": "@sehat-setu-razorpay-key"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
